#!/bin/sh
# Ultimate Installer: the login screen (LightDM for MATE, Xfce, Cinnamon and
# LXDE; SDDM for LXQt; GDM for GNOME Flashback) starts the X11 session of
# the desktop chosen, also with XLibre. Plasma and GNOME keep Wayland, their
# official session, so nothing is changed for them.
set -e
. /var/lib/ultimate.env
case "$GFX" in x11|xlibre) ;; *) exit 0 ;; esac

case "$DESKTOP" in
mate|xfce|cinnamon|lxqt) S=$DESKTOP ;;
lxde)		S=LXDE ;;
gnome-flashback) S=gnome-flashback-metacity ;;
*)		exit 0 ;;
esac

if [ -d /target/etc/lightdm ]; then
	mkdir -p /target/etc/lightdm/lightdm.conf.d
	printf '[Seat:*]\nuser-session=%s\n' "$S" > /target/etc/lightdm/lightdm.conf.d/50-ultimate.conf
fi
if [ -d /target/var/lib/sddm ]; then
	# SDDM starts the last session used; for the first login, this one.
	printf '[Last]\nSession=/usr/share/xsessions/%s.desktop\n' "$S" > /target/var/lib/sddm/state.conf
	chroot /target chown sddm:sddm /var/lib/sddm/state.conf 2>/dev/null || true
fi
exit 0
