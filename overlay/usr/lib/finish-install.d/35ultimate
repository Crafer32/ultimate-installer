#!/bin/sh
# Debian Ultimate: closed firmware is opt-in. With linux-libre the system is
# left 100% free (the stock kernel stays as a fallback, without firmware);
# `ultimate-firmware` lets the user add it later, knowingly.
# Runs after 30hw-detect, which may have installed firmware packages.
set -e
. /var/lib/ultimate.env
install -m 755 /usr/share/ultimate/ultimate-firmware /target/usr/local/sbin/ultimate-firmware
[ "$KERNEL" = linux-libre ] || exit 0
in-target /usr/local/sbin/ultimate-firmware remove || true
exit 0
