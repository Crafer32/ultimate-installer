#!/bin/sh
# Debian Ultimate: closed firmware is opt-in. With linux-libre the system is
# left 100% free; `ultimate-firmware` lets the user add it later, knowingly.
# Runs after 30hw-detect, which may have installed firmware packages.
set -e
. /var/lib/ultimate.env
install -m 755 /usr/share/ultimate/ultimate-firmware /target/usr/local/bin/ultimate-firmware
# Genuen's disc source (apt-setup/generators/39ultimate) goes with the disc.
sed -i '\|^deb \[trusted=yes\] file:/media/cdrom |d' /target/etc/apt/sources.list
[ "$KERNEL" = linux-libre ] || exit 0
in-target /usr/local/bin/ultimate-firmware remove || true
exit 0
