#!/bin/sh
# Ultimate Installer: closed firmware is opt-in. With linux-libre the system is
# left 100% free; `ultimate-firmware` lets the user add it later, knowingly.
# Runs after 30hw-detect, which may have installed firmware packages.
set -e
. /var/lib/ultimate.env
install -m 755 /usr/share/ultimate/ultimate-firmware /target/usr/local/bin/ultimate-firmware
# Genuen's disc source (apt-setup/generators/39ultimate) goes with the disc.
sed -i '\|^deb \[trusted=yes\] file:/media/cdrom |d' /target/etc/apt/sources.list
# Init pin for tasksel (pre-pkgsel.d/20ultimate): the user may switch later.
rm -f /target/etc/apt/preferences.d/ultimate-init
# One kernel: the installer's upgrade step may have added a newer build of it.
OLD=$(chroot /target sh -c "dpkg-query -W -f '\${Package} \${Status}\n' 'linux-image-[0-9]*' | \
	awk '/ installed\$/ && \$1 !~ /-dbg\$/ {print \$1}' | sort -V | head -n -1")
[ -n "$OLD" ] && in-target apt-get -q -y purge $OLD || true
# "Same password for root" ticked (ultimate-rootpw): copy the user's hash.
. /usr/share/debconf/confmodule
if db_get ultimate/rootsame && [ "$RET" = same ] && db_get passwd/username && [ -n "$RET" ]; then
	awk -F: -v OFS=: -v u="$RET" 'NR == FNR { if ($1 == u) h = $2; next }
		$1 == "root" && h != "" { $2 = h } 1' /target/etc/shadow /target/etc/shadow \
		> /target/etc/shadow.ultimate && cat /target/etc/shadow.ultimate > /target/etc/shadow
	rm -f /target/etc/shadow.ultimate
fi
[ "$KERNEL" = linux-libre ] || exit 0
in-target /usr/local/bin/ultimate-firmware remove || true
exit 0
