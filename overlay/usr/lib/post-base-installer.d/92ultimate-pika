#!/bin/sh
# Debian Ultimate (PikaOS): base-installer points apt at a "main" component that
# PikaOS does not have. Use PikaOS's own sources, pinning and dpkg settings
# before the kernel is installed.
. /var/lib/ultimate.env
[ "$DISTRO" = pikaos ] || exit 0
P=/usr/share/ultimate/pika
mkdir -p /target/etc/apt/keyrings /target/etc/apt/sources.list.d \
	/target/etc/apt/preferences.d /target/etc/dpkg/dpkg.cfg.d
cp $P/pika-keyring.gpg.key /target/etc/apt/keyrings/
cp $P/system.sources /target/etc/apt/sources.list.d/
cp $P/0-pika-apt-settings /target/etc/apt/preferences.d/
cp $P/force-overwrite /target/etc/dpkg/dpkg.cfg.d/
: > /target/etc/apt/sources.list
in-target apt-get -q update || true
