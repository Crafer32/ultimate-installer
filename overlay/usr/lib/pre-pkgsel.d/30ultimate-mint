#!/bin/sh
# Ultimate Installer: with Cinnamon, if the user accepts Linux Mint's
# repository, any distro (Devuan, Genuen, Debian) gets Mint's Cinnamon edition.
# Mint is used as a repository, not as a distro:
# its repository goes on top, preferred the way LMDE does it (priority 700),
# and Mint's Cinnamon edition is installed from it.
# Runs after 25ultimate-xlibre, so XLibre (if chosen) is already in place.
set -e
. /usr/share/debconf/confmodule
. /var/lib/ultimate.env
[ "$DESKTOP" = cinnamon ] && [ "$MINT" = true ] || exit 0

K=/target/etc/apt/keyrings
mkdir -p $K /target/etc/apt/sources.list.d /target/etc/apt/preferences.d
cp /usr/share/ultimate/linuxmint-keyring.gpg $K/
# LMDE 7 (gigi) is built on Debian 13 (trixie), the base of Devuan excalibur too.
echo "deb [signed-by=/etc/apt/keyrings/linuxmint-keyring.gpg] http://packages.linuxmint.com gigi main upstream import backport" \
	> /target/etc/apt/sources.list.d/linuxmint.list
cat > /target/etc/apt/preferences.d/official-package-repositories.pref <<PIN
Package: *
Pin: origin packages.linuxmint.com
Pin-Priority: 700
PIN
# Without systemd (Devuan, Genuen) Mint must not bring it in and swap the init.
if [ "$INIT" != systemd ]; then
	cat > /target/etc/apt/preferences.d/ultimate-no-systemd.pref <<PIN
Package: systemd systemd-sysv
Pin: release *
Pin-Priority: -1
PIN
fi

db_progress INFO ultimate/progress-mint
in-target sh -c "apt-get -q -y install ca-certificates; apt-get -q update" || true
in-target sh -c "DEBIAN_FRONTEND=noninteractive apt-get -q -y install linuxmint-keyring mint-meta-cinnamon mint-info-cinnamon lightdm slick-greeter" || \
	logger -t ultimate "Linux Mint packages failed to install"
exit 0
