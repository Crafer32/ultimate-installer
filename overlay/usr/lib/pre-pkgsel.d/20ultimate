#!/bin/sh
# Debian Ultimate: write the Debian sources (systemd path) and, when the
# kernel does not come with the distro, install it in /target instead of the
# stock one, before tasksel installs the desktop.
#   Genuen + linux-libre, Devuan + linux: the distro's own kernel, nothing to do
#   Debian/Devuan + linux-libre: linux-libre from the FSFLA freesh repo
#   Genuen + s6: Genuen's s6 packages (as its own installer installs them)
#   linux-locos: LocOS repo (its newer base-files turn the system into LocOS)
#   PikaOS: its own sources package and its newest kernel
set -e
. /usr/share/debconf/confmodule
. /var/lib/ultimate.env

K=/target/etc/apt/keyrings
S=/target/etc/apt/sources.list.d
mkdir -p $K $S

if [ "$DISTRO" = debian ]; then
	# Devuan's apt-setup writes Devuan security/updates lines; use Debian's.
	[ "$BRANCH" = testing ] && C=forky || C=trixie
	cat > /target/etc/apt/sources.list <<EOF
deb http://deb.debian.org/debian $C main $COMP
deb http://deb.debian.org/debian $C-updates main $COMP
deb http://security.debian.org/debian-security $C-security main $COMP
EOF
	[ "$C" = forky ] && sed -i '/forky-updates/d' /target/etc/apt/sources.list
fi

# Genuen's archive also has Devuan's sysv-rc as "required", so tasksel's
# "standard" task wants it and clashes with openrc/s6. Hide the other inits
# from apt until the install ends (finish-install.d/35ultimate removes this).
if [ "$DISTRO" = genuen ]; then
	[ "$INIT" = s6 ] && OTHER="sysvinit-core openrc" || OTHER="genuen-s6-init"
	cat > /target/etc/apt/preferences.d/ultimate-init <<EOF
Package: sysv-rc file-rc runit-init $OTHER
Pin: release *
Pin-Priority: -1
EOF
fi

case "$DISTRO:$INIT:$KERNEL" in
genuen:s6:*)
	# The same packages as Genuen's choose-init; genuen-s6-init replaces
	# sysvinit-core and openrc.
	PKGS="execline s6 s6-rc s6-rc-policy s6-linux-init genuen-s6-init s6-linux-utils s6-portable-utils"
	;;
debian:*:linux-libre|devuan:*:linux-libre)
	cp /usr/share/ultimate/freesh-archive-keyring.gpg $K/
	echo "deb [signed-by=/etc/apt/keyrings/freesh-archive-keyring.gpg] https://linux-libre.fsfla.org/pub/linux-libre/freesh/ freesh main" > $S/freesh.list
	# stable: the same 6.12 series as Debian; testing: the latest one.
	[ "$BRANCH" = stable ] && PKGS="linux-libre-6.12" || PKGS="linux-libre"
	;;
pikaos:*:*)
	# apt-setup re-added the mirror with a "main" component PikaOS lacks.
	: > /target/etc/apt/sources.list
	PKGS="ca-certificates pika-sources"	# + newest kernel, picked below
	;;
*:*:linux-locos)
	cp /usr/share/ultimate/loc-os-archive-keyring.gpg $K/
	echo "deb [signed-by=/etc/apt/keyrings/loc-os-archive-keyring.gpg] http://fr.loc-os.com chill main" > $S/loc-os.list
	PKGS=""	# versioned kernel packages only: the newest is picked below
	;;
*)
	exit 0
	;;
esac

db_subst ultimate/progress KERNEL "$KERNEL"
db_progress INFO ultimate/progress
# "apt-get update" fails while the install disc is still listed as a source
# (cdrom:// has no Release file here), so its exit status is not checked.
in-target sh -c "apt-get -q -y install ca-certificates; apt-get -q update" || true
case "$KERNEL" in
linux-locos|pikaos)	# versioned kernel packages only: take the newest
	[ "$KERNEL" = pikaos ] && SUFFIX=-pikaos || SUFFIX=-loc-os
	NEWEST=$(chroot /target sh -c "apt-cache pkgnames linux-image- | grep -- '$SUFFIX\$' | sort -V | tail -n 1")
	[ "$KERNEL" = linux-locos ] && PKGS="$NEWEST base-files" || PKGS="$PKGS $NEWEST"
	;;
esac

# Genuen + s6 keeps Genuen's own kernel: only the init changes.
if [ "$DISTRO" = genuen ]; then
	in-target sh -c "DEBIAN_FRONTEND=noninteractive apt-get -q -y install $PKGS" || \
		logger -t ultimate "s6 failed to install; keeping the stock init"
	exit 0
fi
# Only one kernel in the installed system: the stock one is removed once
# the chosen one is in (if that fails, the stock kernel stays).
if in-target sh -c "DEBIAN_FRONTEND=noninteractive apt-get -q -y install $PKGS"; then
	OLD=$(chroot /target dpkg-query -W -f '${Package} ${Status}\n' 'linux-image-*' 2>/dev/null | \
		awk '/ installed$/ {print $1}' | grep -E '^linux-image-(amd64|[0-9].*-amd64)$' || true)
	[ -n "$OLD" ] && in-target apt-get -q -y purge $OLD || true
else
	logger -t ultimate "kernel $KERNEL failed to install; keeping the stock kernel"
fi
# The freesh keyring package brings its own (mirror) source; keep only that one.
[ -f $S/freesh.sources ] && rm -f $S/freesh.list
exit 0
