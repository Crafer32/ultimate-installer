#!/bin/sh
# Debian Ultimate (PikaOS):
# - ppa.pika-os.com sits behind an anti-bot shield that only lets apt-like
#   clients fetch its Release files; the last -U wins in wget.
# - debootstrap misreads PikaOS's InRelease (bad signature), so it is reported
#   as missing and debootstrap checks Release + Release.gpg instead.
for a; do
	case "$a" in http*://ppa.pika-os.com/*/InRelease) exit 8 ;; esac
done
exec /usr/bin/wget.real "$@" -U "Debian APT-HTTP/1.3 (3.0.3)"
