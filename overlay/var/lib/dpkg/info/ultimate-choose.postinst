#!/bin/sh
# Debian Ultimate: asks init, kernel and desktop just before the base system
# is installed, then answers the stock Devuan questions underneath.
set -e
. /usr/share/debconf/confmodule
[ -e /var/run/ultimate-debug ] && { exec 2>/dev/ttyS0; set -x; }

ENV=/var/lib/ultimate.env

db_settitle ultimate/title || true

db_input critical ultimate/init || true
db_go || exit 10
db_get ultimate/init; INIT="$RET"

BLOBS=$(sh /usr/share/ultimate/ultimate-firmware drivers)
if [ -n "$BLOBS" ]; then
	NOTE="Hardware not compatible with linux-libre: $(echo "$BLOBS" | sed 's/ /, /g'). For it to work properly, selecting the \"linux\" kernel is recommended."
else
	NOTE="No hardware needing closed firmware was detected on this computer."
fi
db_subst ultimate/kernel HWNOTE "$NOTE"
db_input critical ultimate/kernel || true
db_go || exit 10
db_get ultimate/kernel; KERNEL="$RET"

db_input critical ultimate/desktop || true
db_go || exit 10
db_get ultimate/desktop; DESKTOP="$RET"

# Answer the stock Devuan questions (choose-init, tasksel, mirror) the same
# way a preseed file does: their templates are not loaded yet, so db_set
# would fail, but debconf-set-selections stores the answer and marks it seen.
# For systemd, choose-init gets an unknown value and does nothing.
case "$DESKTOP" in
	none) TASKS="standard" ;;
	*)    TASKS="desktop, $DESKTOP-desktop, standard" ;;
esac
SEL=/tmp/ultimate.sel
cat > $SEL <<EOF
d-i choose-init/select_init select $INIT
tasksel tasksel/first multiselect $TASKS
EOF

if [ "$INIT" = systemd ]; then
	# Debian base: take it from deb.debian.org instead of the Devuan CD.
	if [ -e /cdrom/.disk/base_installable ]; then
		mkdir -p /run/ultimate-disk
		cp -a /cdrom/.disk/. /run/ultimate-disk/
		rm -f /run/ultimate-disk/base_installable
		mount -o bind /run/ultimate-disk /cdrom/.disk
	fi
	ln -sf debian-archive-keyring.pgp /usr/share/keyrings/archive.gpg
	# Devuan's security/updates generators assume its /merged layout, so they
	# are skipped; pre-pkgsel.d/20ultimate writes the Debian lines instead.
	cat >> $SEL <<EOF
d-i mirror/country string manual
d-i mirror/protocol string http
d-i mirror/http/hostname string deb.debian.org
d-i mirror/http/directory string /debian
d-i mirror/http/proxy string
d-i mirror/suite string stable
d-i mirror/codename string trixie
d-i apt-setup/services-select multiselect
EOF
fi
debconf-set-selections $SEL

cat > $ENV <<EOF
INIT=$INIT
KERNEL=$KERNEL
DESKTOP=$DESKTOP
BLOBS="$BLOBS"
EOF
exit 0
