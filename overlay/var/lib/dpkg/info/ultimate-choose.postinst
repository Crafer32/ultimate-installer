#!/bin/sh
# Debian Ultimate: asks branch, init, kernel, repositories, desktop and
# graphics system just before the base system is installed, picks the distro
# they add up to and answers the stock Devuan questions underneath.
#   stable  + linux-libre + OpenRC/s6         -> Genuen  (base from the disc;
#                                                s6 from its repo)
#   stable  + linux-libre + SysV/runit        -> Devuan + linux-libre (FSFLA)
#   stable  + linux/locos + SysV/OpenRC/runit -> Devuan  (base from the disc;
#                                                LocOS once its repo is added)
#   stable  + systemd                         -> Debian  (base from the net)
#   stable  + systemd + linux + Cinnamon      -> LMDE    (Debian + Mint's repo)
#   testing                                   -> Debian testing (from the net)
#   unstable                                  -> PikaOS (from the net)
set -e
. /usr/share/debconf/confmodule
[ -e /var/run/ultimate-debug ] && { exec 2>/dev/ttyS0; set -x; }

ENV=/var/lib/ultimate.env

ask () {	# ask <question> -> $RET
	db_input critical "$1" || true
	db_go || exit 10
	db_get "$1"
}

db_settitle ultimate/title || true

# Texts built here follow the installer language (English or Spanish).
db_get debian-installer/language || RET=en
case "$RET" in
es*)	T_STABLE="stable"; T_TESTING="testing (Debian testing)"
	T_UNSTABLE="unstable (PikaOS, experimental)"
	T_NOPIKA="(PikaOS necesita una CPU x86-64-v3 con AVX2: esta no lo es.)"
	T_HW="Hardware no compatible con linux-libre: %s. Se recomienda el núcleo \"linux\"."
	T_NOHW="Este equipo no necesita firmware cerrado: linux-libre funcionará bien."
	T_KERNELS="linux-libre, linux (Recomendado), linux-locos (LocOS)"
	T_S6="s6 viene de Genuen y solo funciona con linux-libre."
	T_EXP="experimental" ;;
*)	T_STABLE="stable"; T_TESTING="testing (Debian testing)"
	T_UNSTABLE="unstable (PikaOS, experimental)"
	T_NOPIKA="(PikaOS needs an x86-64-v3 CPU with AVX2: not this one.)"
	T_HW="Hardware not compatible with linux-libre: %s. The \"linux\" kernel is recommended."
	T_NOHW="This computer needs no closed firmware: linux-libre will work fine."
	T_KERNELS="linux-libre, linux (Recommended), linux-locos (LocOS)"
	T_S6="s6 comes from Genuen and only works with linux-libre."
	T_EXP="experimental" ;;
esac

# PikaOS is built for x86-64-v3 CPUs (AVX2, BMI2, FMA, MOVBE).
B_C="stable, testing"; B="$T_STABLE, $T_TESTING"; PIKANOTE=""
if grep -qw avx2 /proc/cpuinfo && grep -qw bmi2 /proc/cpuinfo && \
   grep -qw fma /proc/cpuinfo && grep -qw movbe /proc/cpuinfo; then
	B_C="$B_C, unstable"; B="$B, $T_UNSTABLE"
else
	PIKANOTE="$T_NOPIKA"
fi
db_subst ultimate/branch BRANCHES_C "$B_C"
db_subst ultimate/branch BRANCHES "$B"
db_subst ultimate/branch PIKANOTE "$PIKANOTE"
ask ultimate/branch; BRANCH="$RET"
if [ "$BRANCH" = stable ]; then
	ask ultimate/init; INIT="$RET"
else
	INIT=systemd
fi

BLOBS=$(sh /usr/share/ultimate/ultimate-firmware drivers)
# PikaOS comes with its own kernel and repositories: no kernel/repo questions.
if [ "$BRANCH" = unstable ]; then
	KERNEL=pikaos; COMP=""
else
	if [ -n "$BLOBS" ]; then
		NOTE=$(printf "$T_HW" "$(echo "$BLOBS" | sed 's/ /, /g')")
	else
		NOTE="$T_NOHW"
	fi
	# s6 only exists in Genuen: the screen is shown, with linux-libre only.
	if [ "$INIT" = s6 ]; then
		db_subst ultimate/kernel KERNELS_C "linux-libre"
		db_subst ultimate/kernel KERNELS "${T_KERNELS%%,*}"
		NOTE="$T_S6"
	elif [ "$BRANCH" = testing ]; then
		# LocOS is built on stable: it is not offered with testing.
		db_subst ultimate/kernel KERNELS_C "linux-libre, linux"
		db_subst ultimate/kernel KERNELS "${T_KERNELS%, *}"
	else
		db_subst ultimate/kernel KERNELS_C "linux-libre, linux, linux-locos"
		db_subst ultimate/kernel KERNELS "$T_KERNELS"
	fi
	db_subst ultimate/kernel HWNOTE "$NOTE"
	ask ultimate/kernel; KERNEL="$RET"

	# linux-libre gets main only; any other kernel lets the user pick the rest.
	COMP=""
	if [ "$KERNEL" != linux-libre ]; then
		ask ultimate/components; COMP=$(echo "$RET" | sed 's/,//g')
	fi
fi

ask ultimate/desktop; DESKTOP="$RET"

# Graphics system. X11 (Xorg) comes with the distro; XLibre from its own
# repository; Wayland only where the desktop has a Wayland session in that
# branch (Debian 13 / Devuan 6: Xfce, Cinnamon and LXQt experimental, Plasma
# and GNOME by default; MATE, LXDE and Flashback: X11 only).
# GNOME in testing is Wayland only and PikaOS brings its own: no question.
case "$BRANCH:$DESKTOP" in
unstable:*|*:none)	GFX=default ;;
testing:gnome)		GFX=wayland ;;
*)
	case "$DESKTOP" in
	kde|gnome)	G_C="wayland, x11, xlibre"; G="Wayland, X11 (Xorg), XLibre"; DEF=wayland ;;
	xfce|cinnamon|lxqt) G_C="x11, xlibre, wayland"; G="X11 (Xorg), XLibre, Wayland ($T_EXP)"; DEF=x11 ;;
	*)		G_C="x11, xlibre"; G="X11 (Xorg), XLibre"; DEF=x11 ;;
	esac
	db_subst ultimate/graphics GFX_C "$G_C"
	db_subst ultimate/graphics GFX "$G"
	# The default depends on the desktop, so it is set here, not in the template.
	db_set ultimate/graphics "$DEF"
	ask ultimate/graphics; GFX="$RET"
	;;
esac

if [ "$BRANCH" = unstable ]; then
	DISTRO=pikaos
elif [ "$INIT" = systemd ] && [ "$BRANCH:$KERNEL:$DESKTOP" = stable:linux:cinnamon ]; then
	# Debian stable + Cinnamon is what LMDE is: Linux Mint's packages on top.
	DISTRO=lmde
elif [ "$INIT" = systemd ]; then
	DISTRO=debian
elif [ "$KERNEL" = linux-libre ] && [ "$INIT" = openrc -o "$INIT" = s6 ]; then
	# Genuen has no plain SysV (its sysvinit-core needs openrc or s6 as rc),
	# so SysV and runit with linux-libre are Devuan + FSFLA's linux-libre.
	DISTRO=genuen
else
	DISTRO=devuan
fi

# Answer the stock Devuan questions the same way a preseed file does: their
# templates are not loaded yet, so db_set would fail, but
# debconf-set-selections stores the answer and marks it as seen.
# For systemd, choose-init gets an unknown value and does nothing.
# LMDE's Cinnamon comes from Mint (pre-pkgsel.d/30ultimate-lmde), not tasksel.
case "$DISTRO:$DESKTOP" in
	*:none) TASKS="standard" ;;
	lmde:*) TASKS="desktop, standard" ;;
	*)      TASKS="desktop, $DESKTOP-desktop, standard" ;;
esac
# Without .disk/base_installable the base system comes from the mirror.
hide_base_installable () {
	[ -e /cdrom/.disk/base_installable ] || return 0
	mkdir -p /run/ultimate-disk
	cp -a /cdrom/.disk/. /run/ultimate-disk/
	rm -f /run/ultimate-disk/base_installable
	mount -o bind /run/ultimate-disk /cdrom/.disk
}
has () { case " $COMP " in *" $1 "*) echo true ;; *) echo false ;; esac; }
# GRUB goes to the disk chosen in guided partitioning or, when partitioning
# by hand, to the disk that holds /. If neither is clear (manual LVM or
# encryption), grub-installer still asks.
grub_disk () {
	if db_get partman-auto/select_disk 2>/dev/null && [ -n "$RET" ]; then
		basename "$RET" | tr = /
		return
	fi
	ROOT=$(awk '$2 == "/target" {print $1}' /proc/mounts)
	case "$ROOT" in /dev/sd*|/dev/vd*|/dev/nvme*|/dev/mmcblk*) ;; *) return ;; esac
	echo /dev/$(basename "$(dirname "$(readlink -f /sys/class/block/${ROOT#/dev/})")")
}
GRUBDEV=""
# Only on the "Install" entry (it loads our preseed); "Expert install" asks.
db_get preseed/file 2>/dev/null && [ -n "$RET" ] && GRUBDEV=$(grub_disk)
SEL=/tmp/ultimate.sel
cat > $SEL <<EOF
d-i choose-init/select_init select $INIT
tasksel tasksel/first multiselect $TASKS
d-i apt-setup/non-free-firmware boolean $(has non-free-firmware)
d-i apt-setup/contrib boolean $(has contrib)
d-i apt-setup/non-free boolean $(has non-free)
EOF
[ -n "$GRUBDEV" ] && cat >> $SEL <<EOF
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean true
d-i grub-installer/bootdev string $GRUBDEV
EOF

case "$DISTRO" in
genuen)
	# Genuen's own netinstall ISO (/genuen.iso on this disc) is mounted over
	# the disc root, so everything that reads /cdrom from now on (base system,
	# kernel, apt, choose-init) sees Genuen instead of Devuan.
	grep -q Genuen /cdrom/.disk/info || mount -o loop,ro /cdrom/genuen.iso /cdrom
	# Genuen ships opensysusers instead of systemd-standalone-sysusers, which
	# Devuan's debootstrap script adds to the base when cron is in it.
	sed 's/systemd-standalone-sysusers/opensysusers/' \
		/usr/share/debootstrap/scripts/ceres > /var/lib/ultimate-genuen.debootstrap
	cat >> $SEL <<EOF
d-i base-installer/debootstrap_script string /var/lib/ultimate-genuen.debootstrap
d-i base-installer/includes string genuen-archive-keyring
d-i mirror/country string manual
d-i mirror/protocol string http
d-i mirror/http/hostname string packages.genuen.org
d-i mirror/http/directory string /merged
d-i mirror/suite string stable
d-i mirror/codename string excalibur
EOF
	;;
pikaos)
	hide_base_installable
	ln -sf pika-archive-keyring.gpg /usr/share/keyrings/archive.gpg
	sed 's/^\([[:space:]]*\)extract \$required$/\1ultimate_extract_required/' \
		/usr/share/debootstrap/scripts/debian-common > /var/lib/ultimate-pika.common
	if [ ! -e /usr/bin/wget.real ]; then
		mv /usr/bin/wget /usr/bin/wget.real
		cp /usr/share/ultimate/pika-wget /usr/bin/wget
	fi
	# PikaOS marks both man and man-db as required, and they conflict.
	cat >> $SEL <<EOF
d-i base-installer/debootstrap_script string /usr/share/ultimate/pika.debootstrap
d-i base-installer/excludes string man-db
d-i mirror/country string manual
d-i mirror/protocol string http
d-i mirror/http/hostname string ppa.pika-os.com
d-i mirror/http/directory string /
d-i mirror/http/proxy string
d-i mirror/suite string pika
d-i mirror/codename string pika
d-i apt-setup/services-select multiselect
EOF
	;;
debian|lmde)
	# Debian base: from deb.debian.org instead of the disc.
	hide_base_installable
	ln -sf debian-archive-keyring.pgp /usr/share/keyrings/archive.gpg
	[ "$BRANCH" = testing ] && CODENAME=forky || CODENAME=trixie
	# Devuan's security/updates generators assume its /merged layout, so they
	# are skipped; pre-pkgsel.d/20ultimate writes the Debian lines instead.
	cat >> $SEL <<EOF
d-i mirror/country string manual
d-i mirror/protocol string http
d-i mirror/http/hostname string deb.debian.org
d-i mirror/http/directory string /debian
d-i mirror/http/proxy string
d-i mirror/suite string $BRANCH
d-i mirror/codename string $CODENAME
d-i apt-setup/services-select multiselect
EOF
	;;
esac
debconf-set-selections $SEL

cat > $ENV <<EOF
BRANCH=$BRANCH
DISTRO=$DISTRO
INIT=$INIT
KERNEL=$KERNEL
COMP="$COMP"
DESKTOP=$DESKTOP
GFX=$GFX
BLOBS="$BLOBS"
EOF
exit 0
